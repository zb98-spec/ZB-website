# Flask
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-with-a-generated-secret"

# Postgres connection string.
# Free options: Neon (neon.tech) or Supabase (supabase.com) both offer a
# free Postgres tier that works well with a small always/scale-to-zero app.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http(s)://<your-domain>/login/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign in with Apple (Apple Developer account required)
# Return URL: https://<your-domain>/login/apple/callback (Apple requires HTTPS,
# so this can only be tested against a deployed URL or a tunnel like ngrok).
APPLE_CLIENT_ID=""       # your Services ID
APPLE_TEAM_ID=""         # Apple Developer Team ID
APPLE_KEY_ID=""          # Key ID of the "Sign in with Apple" key
APPLE_PRIVATE_KEY=""     # contents of the downloaded .p8 key file

# Email, for "forgot password" reset links. Any SMTP account works - e.g. a
# Gmail account with an app password (myaccount.google.com/apppasswords),
# or a free tier from Resend/Mailgun/etc. Leave unset to disable password
# reset by email (the change-password page while logged in still works).
MAIL_SERVER=""           # e.g. smtp.gmail.com
MAIL_PORT="587"
MAIL_USE_TLS="true"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_DEFAULT_SENDER=""   # defaults to MAIL_USERNAME if unset

# Gemini API key, for the Wine Assistant chat bot and the "Research all with
# AI" button on the Wine Library page. Get one at aistudio.google.com/apikey
# (free tier available). Leave unset to hide both features.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"   # optional, this is already the default

# Telegram bot (wine cellar bot: check drinking windows, add bottles, log
# tastings, from Telegram). Create a bot with @BotFather on Telegram to get
# TELEGRAM_BOT_TOKEN. TELEGRAM_WEBHOOK_SECRET is any random string you make
# up (e.g. `openssl rand -hex 24`) - it's how the app verifies an incoming
# webhook request really came from Telegram. Leave either unset to disable
# the bot (hides the linking option on the Account page, and the webhook
# route 404s). After deploying with both set, run
# scripts/set_telegram_webhook.sh once to point Telegram at the app.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
