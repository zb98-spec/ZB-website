# Postgres connection strings.
# Free options: Neon (neon.tech) or Supabase (supabase.com) both offer a
# free Postgres tier that works well with Cloud Run.
# DATABASE_URL is used at runtime (use the pooled/"pgbouncer" connection string).
# DIRECT_URL is used only for running migrations (use the direct connection string).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-generated-secret"
# Set to your deployed URL in production, e.g. https://hub.example.com
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign in with Apple (Apple Developer account required)
# clientId is your Services ID; clientSecret is a signed JWT you generate
# from your Apple key (see README for details).
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
